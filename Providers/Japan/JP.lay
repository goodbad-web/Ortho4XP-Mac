# Japan Latest Seamless Imagery
# Unsure about copyright
grid_type=webmercator
url_template=https://cyberjapandata.gsi.go.jp/xyz/seamlessphoto/{zoom}/{x}/{y}.jpg
max_threads=16
fake_headers={'User-Agent': user_agent_generic, 'Referer': 'https://maps.gsi.go.jp/', 'Connection': 'keep-alive', 'Accept': 'image/jpeg'}
imagery_dir=grouped
in_GUI=True
